  m_Script: {fileID: 11500000, guid: 2c0ff7a2a148b444ebcd3467b2cfa79a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  grabObj1: {fileID: 0}
  grabObj2: {fileID: 0}
  btnTrigger: {fileID: 393802993}
  speechList:
  - "\u5C0F\u670B\u53CB\uFF0C\u4F60\u770B\uFF01\u8FD9\u4E2A\u6447\u6746\u5C31\u50CF\u4E00\u6761\u795E\u5947\u7684\u5C0F\u8DEF\uFF5E\u5982\u679C\u4F60\u5F80\u524D\u63A8\uFF0C\u5C31\u4F1A\u6CBF\u7740\u5C0F\u8DEF\u5F80\u524D\u8D70\uFF1B\u5982\u679C\u4F60\u5F80\u540E\u62C9\uFF0C\u5C31\u4F1A\u6162\u6162\u9000\u56DE\u6765\uFF5E\u8BA9\u6211\u4EEC\u8BD5\u8BD5\u770B\u5427~"
  - "\u4F60\u770B\uFF01\u73A9\u5177\u5C0F\u718A\u548C\u72D0\u72F8\u6B63\u5728\u548C\u4F60\u6253\u62DB\u547C\u5462\uFF5E\u5982\u679C\u4F60\u60F3\u548C\u4ED6\u4EEC\u73A9\uFF0C\u53EF\u4EE5\u7528\u5DE6\u624B\u67C4\u7684\u6293\u53D6\u952E\uFF0C\u5BF9\u51C6\u4ED6\u4EEC\uFF0C\u6309\u4E0B\u4E0D\u677E\u5C31\u53EF\u4EE5\u6293\u53D6\u4ED6\u4EEC\u54E6\uFF01"
  - "\u63A5\u4E0B\u6765\u8BA9\u6211\u4EEC\u8BD5\u8BD5\u5DE6\u624B\u67C4\u7684\u6273\u673A\u952E\u54E6\uFF0C\u5C0F\u670B\u53CB\uFF0C\u4F60\u770B\uFF01\u4F60\u9762\u524D\u6309\u94AE\u597D\u50CF\u5728\u548C\u4F60\u7728\u773C\u775B\u5462\uFF5E\u53EF\u4EE5\u7528\u5DE6\u624B\u67C4\u7684\u5C04\u7EBF\u5BF9\u51C6\u5B83\u518D\u6309\u4E0B\u548C\u5B83\u4E00\u8D77\u73A9\u54E6"
  - "\u7136\u540E\u662F\u53F3\u624B\u67C4\u7684\u6447\u6746\u54E6\uFF0C\u5982\u679C\u4F60\u5F80\u4E0A\u63A8\uFF0C\u5C31\u4F1A\u50CF\u5C0F\u661F\u661F\u4E00\u6837\u2018\u54BB\u2019\u5730\u98DE\u5230\u4E00\u4E2A\u65B0\u5730\u65B9\uFF01\u8981\u4E0D\u8981\u518D\u8BD5\u8BD5\u770B\uFF1F"
  - "\u5E76\u4E14\u53F3\u624B\u67C4\u7684\u6447\u6746\u5C31\u50CF\u4E00\u4E2A\u5C0F\u9B54\u6CD5\u65B9\u5411\u76D8\uFF5E\u5982\u679C\u4F60\u5F80\u5DE6\u63A8\uFF0C\u6211\u4EEC\u5C31\u4F1A\u5411\u5DE6\u8F6C\uFF0C\u5982\u679C\u4F60\u5F80\u53F3\u63A8\uFF0C\u6211\u4EEC\u5C31\u4F1A\u5411\u53F3\u8F6C"
  - "\u4E0B\u9762\u662F\u53F3\u624B\u67C4\u7684\u6293\u53D6\u952E\uFF0C\u5B83\u548C\u5DE6\u624B\u67C4\u7684\u6293\u53D6\u952E\u76F8\u540C\u54E6\uFF0C\u8BD5\u7740\u7528\u5B83\u6293\u53D6\u73A9\u5177\u5C0F\u718A\u5427~"
  - "\u53F3\u624B\u67C4\u7684\u6273\u673A\u952E\u4E5F\u548C\u5DE6\u624B\u67C4\u7684\u529F\u80FD\u76F8\u540C\uFF0C\u5C1D\u8BD5\u7528\u5B83\u70B9\u51FB\u6309\u94AE\u5427~"
