  - {fileID: 384662039}
  - {fileID: 1070065421}
  putText:
  - "\u7EE7\u7EED\u52A0\u6CB9\uFF0C\u4E0B\u4E00\u4E2A\u989C\u8272\u4E5F\u96BE\u4E0D\u5012\u4F60\uFF01"
  - "\u6311\u6218\u5347\u7EA7\uFF01\u8FD9\u6B21\u7684\u989C\u8272\u85CF\u5F97\u66F4\u5DE7\u5999\u4E86\uFF0C\u4F60\u80FD\u627E\u5230\u5417\uFF1F"
  - "\u4F60\u627E\u989C\u8272\u7684\u901F\u5EA6\u6BD4\u5F69\u8679\u51FA\u73B0\u8FD8\u5FEB\u5462\uFF01"
  - "\u54C7\uFF01\u4F60\u7684\u5C0F\u773C\u775B\u771F\u5389\u5BB3\uFF0C\u8FD9\u4E48\u5FEB\u5C31\u627E\u5230\u4E86\uFF01"
  - "\u592A\u68D2\u4E86\uFF01\u4F60\u7B80\u76F4\u50CF\u989C\u8272\u5C0F\u4FA6\u63A2\u4E00\u6837\u806A\u660E\uFF01"
  putFailText:
  - "\u54C8\u54C8\uFF0C\u5B83\u5047\u88C5\u81EA\u5DF1\u662F\u522B\u7684\u989C\u8272\u9A97\u8FC7\u4F60\u4E86\uFF01\u518D\u4ED4\u7EC6\u770B\u770B~"
  - "\u8FD9\u4E2A\u989C\u8272\u5F88\u63A5\u8FD1\u4E86\uFF01\u770B\u770B\u5468\u56F4\u6709\u6CA1\u6709\u66F4\u5339\u914D\u7684\uFF1F"
  - "\u6CA1\u5173\u7CFB\uFF0C\u9519\u8BEF\u662F\u627E\u5230\u6B63\u786E\u7B54\u6848\u7684\u7B2C\u4E00\u6B65\uFF01"
  - "\u4F60\u627E\u5F97\u5F88\u8BA4\u771F\uFF0C\u518D\u8BD5\u4E00\u6B21\u80AF\u5B9A\u80FD\u53D1\u73B0\u5B83\uFF01"
  - "\u54C7\uFF0C\u4F60\u6392\u9664\u6389\u4E86\u4E00\u4E2A\u9519\u8BEF\u9009\u9879\uFF0C\u79BB\u6210\u529F\u66F4\u8FD1\u4E86\uFF01"
  - "\u5B83\u53EF\u80FD\u5077\u5077\u6362\u4F4D\u7F6E\u4E86\uFF0C\u6211\u4EEC\u518D\u6765\u4E00\u6B21\uFF01"
  putDownText:
